{{!
    @template block_elediaaitutor/launcher

    The chat shell for the eLeDia.ai Tutor block.

    For the "embedded" display mode the panel is shown inline; for docked, modal
    and fullscreen modes only the launch button is shown inline and the panel is
    portalled to the document body when opened (see the chat AMD module), which
    keeps it clear of any block-container overflow/z-index clipping.

    Classes prefixed "elediaaitutor-" so nothing leaks into surrounding markup.

    Example context (json):
    {
        "uniqid": "elediaaitutor_abc123",
        "instanceid": 7,
        "displaymode": "embedded",
        "embedded": true,
        "persona": "eLeDia.ai Tutor",
        "welcome": "<p>Hi! How can I help?</p>",
        "historyenabled": true,
        "launchlabel": "Open the eLeDia.ai Tutor"
    }
}}
<div class="elediaaitutor-root" data-region="elediaaitutor" id="{{uniqid}}"
     data-mode="{{displaymode}}">

    {{^embedded}}
        <button type="button" class="btn btn-primary elediaaitutor-launch"
                data-action="launch" aria-haspopup="dialog" aria-expanded="false">
            <span class="elediaaitutor-launch-icon" aria-hidden="true">
                <img class="elediaaitutor-launch-img" src="{{avatarurl}}" alt="" width="20" height="20">
            </span>
            <span class="elediaaitutor-launch-text">{{launchlabel}}</span>
        </button>
    {{/embedded}}

    <div class="elediaaitutor-panel {{#embedded}}elediaaitutor-embedded{{/embedded}}"
         data-region="panel"
         role="region"
         aria-label="{{persona}}"
         {{^embedded}}hidden{{/embedded}}>

        <div class="elediaaitutor-backdrop" data-action="close" hidden></div>

        <div class="elediaaitutor-window" role="document">
            <header class="elediaaitutor-header">
                <div class="elediaaitutor-identity">
                    <span class="elediaaitutor-avatar" aria-hidden="true">
                        <img class="elediaaitutor-avatar-img" src="{{avatarurl}}" alt="" width="34" height="34">
                        <span class="elediaaitutor-status-dot"></span>
                    </span>
                    <span class="elediaaitutor-identity-text">
                        <span class="elediaaitutor-title">{{persona}}</span>
                        <span class="elediaaitutor-presence">{{#str}}online, block_elediaaitutor{{/str}}</span>
                    </span>
                </div>
                <div class="elediaaitutor-actions">
                    {{#historyenabled}}
                        <button type="button" class="btn btn-icon elediaaitutor-iconbtn"
                                data-action="history" aria-label="{{#str}}history, block_elediaaitutor{{/str}}"
                                title="{{#str}}history, block_elediaaitutor{{/str}}">
                            <i class="fa fa-clock-o" aria-hidden="true"></i>
                        </button>
                    {{/historyenabled}}
                    <button type="button" class="btn btn-icon elediaaitutor-iconbtn"
                            data-action="newconversation" aria-label="{{#str}}newconversation, block_elediaaitutor{{/str}}"
                            title="{{#str}}newconversation, block_elediaaitutor{{/str}}">
                        <i class="fa fa-plus" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn btn-icon elediaaitutor-iconbtn"
                            data-action="privacy" aria-label="{{#str}}privacyguidelines, block_elediaaitutor{{/str}}"
                            title="{{#str}}privacyguidelines, block_elediaaitutor{{/str}}"
                            aria-haspopup="dialog">
                        <i class="fa fa-shield" aria-hidden="true"></i>
                    </button>
                    {{^embedded}}
                        <button type="button" class="btn btn-icon elediaaitutor-iconbtn"
                                data-action="close" aria-label="{{#str}}close, block_elediaaitutor{{/str}}"
                                title="{{#str}}close, block_elediaaitutor{{/str}}">
                            <i class="fa fa-times" aria-hidden="true"></i>
                        </button>
                    {{/embedded}}
                </div>
            </header>

            {{#historyenabled}}
                <div class="elediaaitutor-history" data-region="history" hidden
                     role="region" aria-label="{{#str}}history, block_elediaaitutor{{/str}}">
                    <div class="elediaaitutor-history-empty" data-region="history-empty">
                        {{#str}}nohistory, block_elediaaitutor{{/str}}
                    </div>
                    <ul class="elediaaitutor-history-list" data-region="history-list"></ul>
                </div>
            {{/historyenabled}}

            <div class="elediaaitutor-log" data-region="log"
                 role="log" aria-live="polite" aria-atomic="false"
                 aria-label="{{#str}}conversation, block_elediaaitutor{{/str}}" tabindex="0">
                <div class="elediaaitutor-message elediaaitutor-assistant elediaaitutor-welcome">
                    <div class="elediaaitutor-meta">
                        <span class="elediaaitutor-msg-avatar" aria-hidden="true">
                            <img class="elediaaitutor-msg-avatar-img" src="{{avatarurl}}" alt="" width="20" height="20">
                        </span>
                        <span class="elediaaitutor-sender">{{persona}}</span>
                    </div>
                    <div class="elediaaitutor-bubble">{{{welcome}}}</div>
                </div>
            </div>

            <div class="elediaaitutor-status" data-region="status" role="status" aria-live="polite"></div>

            {{#stylechoice}}
                <div class="elediaaitutor-styles" data-region="styles" role="radiogroup"
                     aria-label="{{#str}}answerstyle, block_elediaaitutor{{/str}}">
                    {{#styles}}
                        <button type="button" class="elediaaitutor-stylechip{{#active}} elediaaitutor-stylechip-active{{/active}}"
                                role="radio" aria-checked="{{#active}}true{{/active}}{{^active}}false{{/active}}"
                                data-action="style" data-style="{{key}}">{{label}}</button>
                    {{/styles}}
                </div>
            {{/stylechoice}}
            {{#stylelocked}}
                <div class="elediaaitutor-styles">
                    <span class="elediaaitutor-stylechip elediaaitutor-stylechip-locked"
                          title="{{#str}}answerstyle, block_elediaaitutor{{/str}}">
                        <i class="fa fa-lock" aria-hidden="true"></i> {{lockedlabel}}
                    </span>
                </div>
            {{/stylelocked}}

            <form class="elediaaitutor-composer" data-region="composer">
                <label class="sr-only" for="{{uniqid}}_input">
                    {{#str}}messagelabel, block_elediaaitutor{{/str}}
                </label>
                <textarea id="{{uniqid}}_input" class="elediaaitutor-input" data-region="input"
                          rows="1" autocomplete="off"
                          placeholder="{{#str}}inputplaceholder, block_elediaaitutor{{/str}}"></textarea>
                <button type="submit" class="elediaaitutor-send" data-action="send"
                        aria-label="{{#str}}send, block_elediaaitutor{{/str}}">
                    <i class="fa fa-paper-plane" aria-hidden="true"></i>
                </button>
            </form>

            <div class="elediaaitutor-footer">{{#str}}poweredby, block_elediaaitutor{{/str}}</div>
        </div>
    </div>
</div>
