{{!
    @template block_elediaaitutor/unavailable

    Shown when the tutor cannot run. Admins/managers see the actionable cause;
    everyone else sees a neutral message.

    Example context (json):
    {
        "isadmin": true,
        "message": "The MCP connector plugin is not installed."
    }
}}
<div class="elediaaitutor-unavailable {{#isadmin}}alert alert-warning{{/isadmin}}{{^isadmin}}text-muted{{/isadmin}}"
     role="status">
    {{#isadmin}}<strong>{{#str}}configerror, block_elediaaitutor{{/str}}</strong><br>{{/isadmin}}
    {{message}}
</div>
