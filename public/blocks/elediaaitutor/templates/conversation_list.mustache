{{!
    @template block_elediaaitutor/conversation_list

    The list of a user's stored conversations, rendered client-side.

    Example context (json):
    {
        "conversations": [
            {
                "id": 12,
                "conversationid": "abc-123",
                "title": "Assignment help",
                "preview": "What do I need to do this week?",
                "deletelabel": "Delete"
            }
        ]
    }
}}
{{#conversations}}
    <li class="elediaaitutor-history-item" data-region="conversation"
        data-id="{{id}}" data-conversationid="{{conversationid}}">
        <button type="button" class="elediaaitutor-history-open" data-action="open-conversation">
            <span class="elediaaitutor-history-title">{{#title}}{{title}}{{/title}}{{^title}}{{preview}}{{/title}}</span>
            <span class="elediaaitutor-history-preview">{{preview}}</span>
        </button>
        <button type="button" class="btn btn-icon btn-sm elediaaitutor-iconbtn"
                data-action="delete-conversation" aria-label="{{deletelabel}}" title="{{deletelabel}}">
            <i class="fa fa-trash" aria-hidden="true"></i>
        </button>
    </li>
{{/conversations}}
