{{!
    @template block_elediaaitutor/privacy_info

    Body of the privacy guidelines modal: AI accuracy warning, what is sent,
    what is stored, the long-term memory opt-in, and data deletion controls.
    All visible text comes from language strings; the JS module wires up the
    toggle and the delete button after the modal is created.

    When "hascustom" is set, "customtext" holds admin-provided, server-side
    formatted HTML (institution-specific privacy guidelines) that replaces the
    built-in informational sections. The long-term memory opt-in and the
    deletion controls are always rendered.

    Example context (json):
    {
        "uniqid": "elediaaitutor_abc123",
        "ltmenabled": false,
        "candelete": true,
        "hascustom": false,
        "customtext": ""
    }
}}
<div class="elediaaitutor-privacy" data-region="privacy-info">
    {{#hascustom}}
        <div class="elediaaitutor-privacy-custom">{{{customtext}}}</div>
    {{/hascustom}}
    {{^hascustom}}
    <p>{{#str}}privacy_intro, block_elediaaitutor{{/str}}</p>

    <div class="alert alert-warning" role="alert">
        <strong>{{#str}}privacy_accuracy_title, block_elediaaitutor{{/str}}</strong><br>
        {{#str}}privacy_accuracy_body, block_elediaaitutor{{/str}}
    </div>

    <h5>{{#str}}privacy_sent_title, block_elediaaitutor{{/str}}</h5>
    <p>{{#str}}privacy_sent_body, block_elediaaitutor{{/str}}</p>

    <h5>{{#str}}privacy_storage_title, block_elediaaitutor{{/str}}</h5>
    <p>{{#str}}privacy_storage_body, block_elediaaitutor{{/str}}</p>
    {{/hascustom}}

    <h5>{{#str}}privacy_ltm_title, block_elediaaitutor{{/str}}</h5>
    <p>{{#str}}privacy_ltm_body, block_elediaaitutor{{/str}}</p>
    <div class="form-check">
        <input type="checkbox" class="form-check-input" id="{{uniqid}}_ltm"
               data-region="ltm-toggle" {{#ltmenabled}}checked{{/ltmenabled}}>
        <label class="form-check-label" for="{{uniqid}}_ltm">
            {{#str}}ltm_optin, block_elediaaitutor{{/str}}
        </label>
    </div>
    <div class="small text-muted mb-3" data-region="ltm-status" role="status" aria-live="polite"></div>

    <h5>{{#str}}privacy_deletion_title, block_elediaaitutor{{/str}}</h5>
    <p>{{#str}}privacy_deletion_body, block_elediaaitutor{{/str}}</p>
    {{#candelete}}
        <button type="button" class="btn btn-outline-danger" data-action="delete-all">
            {{#str}}deletealldata, block_elediaaitutor{{/str}}
        </button>
        <div class="small text-muted mt-2" data-region="delete-status" role="status" aria-live="polite"></div>
    {{/candelete}}
</div>
