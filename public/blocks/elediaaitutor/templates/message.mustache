{{!
    @template block_elediaaitutor/message

    A single chat message bubble. Rendered client-side by the chat AMD module.

    For user messages, the "text" value is escaped by Mustache (HTML-safe). For
    assistant messages, the "html" value is server-sanitised Markdown output and
    is intentionally rendered unescaped (triple-mustache).

    Example context (json):
    {
        "isuser": false,
        "isassistant": true,
        "sendername": "eLeDia.ai Tutor",
        "avatarurl": "https://moodle.example.com/blocks/elediaaitutor/pix/logo.png",
        "html": "<p>Here is your answer.</p>",
        "text": "",
        "failed": false,
        "sources": [
            {"title": "Week 1 notes", "url": "https://example.com/n", "hasurl": true, "snippet": "..."}
        ],
        "hassources": true,
        "copylabel": "Copy answer",
        "retrylabel": "Retry"
    }
}}
<div class="elediaaitutor-message {{#isuser}}elediaaitutor-user{{/isuser}}{{#isassistant}}elediaaitutor-assistant{{/isassistant}}{{#failed}} elediaaitutor-failed{{/failed}}"
     data-region="message" role="article">
    <div class="elediaaitutor-meta">
        {{#isassistant}}<span class="elediaaitutor-msg-avatar" aria-hidden="true">
            <img class="elediaaitutor-msg-avatar-img" src="{{avatarurl}}" alt="" width="20" height="20">
        </span>{{/isassistant}}
        <span class="elediaaitutor-sender">{{sendername}}</span>
        {{#showgrounding}}
            {{#grounded}}
                <span class="elediaaitutor-grounding elediaaitutor-grounded"
                      title="{{#str}}groundedbadge_title, block_elediaaitutor{{/str}}">
                    <i class="fa fa-book" aria-hidden="true"></i>
                    {{#str}}groundedbadge, block_elediaaitutor{{/str}}
                </span>
            {{/grounded}}
            {{^grounded}}
                <span class="elediaaitutor-grounding elediaaitutor-ungrounded"
                      title="{{#str}}ungroundedbadge_title, block_elediaaitutor{{/str}}">
                    <i class="fa fa-info-circle" aria-hidden="true"></i>
                    {{#str}}ungroundedbadge, block_elediaaitutor{{/str}}
                </span>
            {{/grounded}}
        {{/showgrounding}}
    </div>
    <div class="elediaaitutor-bubble">
        {{#isuser}}{{text}}{{/isuser}}
        {{#isassistant}}
            <div class="elediaaitutor-markdown">{{{html}}}</div>
            {{#hassources}}
                <div class="elediaaitutor-sources">
                    <div class="elediaaitutor-sources-title">{{#str}}sources, block_elediaaitutor{{/str}}</div>
                    <ul class="elediaaitutor-sources-list">
                        {{#sources}}
                            <li class="elediaaitutor-source">
                                {{#num}}<span class="elediaaitutor-source-num">[S{{num}}]</span> {{/num}}
                                {{#hasurl}}
                                    <a href="{{url}}" target="_blank" rel="noopener noreferrer">{{title}}</a>
                                {{/hasurl}}
                                {{^hasurl}}<span>{{title}}</span>{{/hasurl}}
                                {{#snippet}}<span class="elediaaitutor-source-snippet">{{snippet}}</span>{{/snippet}}
                            </li>
                        {{/sources}}
                    </ul>
                </div>
            {{/hassources}}
        {{/isassistant}}
    </div>
    {{#isassistant}}
        <div class="elediaaitutor-message-actions">
            <button type="button" class="btn btn-icon btn-sm elediaaitutor-iconbtn"
                    data-action="copy" aria-label="{{copylabel}}" title="{{copylabel}}">
                <i class="fa fa-copy" aria-hidden="true"></i>
            </button>
        </div>
    {{/isassistant}}
    {{#failed}}
        <div class="elediaaitutor-message-actions">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-action="retry">{{retrylabel}}</button>
        </div>
    {{/failed}}
</div>
