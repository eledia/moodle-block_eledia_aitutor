{{!
    @template block_eledia_aitutor/launcher

    The chat shell for the eLeDia.ai Tutor block.

    For the "embedded" display mode the panel is shown inline; for docked, modal
    and fullscreen modes only the launch button is shown inline and the panel is
    portalled to the document body when opened (see the chat AMD module), which
    keeps it clear of any block-container overflow/z-index clipping.

    Classes prefixed "eledia_aitutor-" so nothing leaks into surrounding markup.

    Example context (json):
    {
        "uniqid": "eledia_aitutor_abc123",
        "instanceid": 7,
        "displaymode": "embedded",
        "embedded": true,
        "persona": "eLeDia.ai Tutor",
        "welcome": "<p>Hi! How can I help?</p>",
        "historyenabled": true,
        "launchlabel": "Open the eLeDia.ai Tutor",
        "logourl": "https://example.com/pix/logo.svg",
        "avatarurl": "https://example.com/pix/avatar.svg",
        "consented": true,
        "dashboardmode": false,
        "dashboardgreeting": "Have you moodled today?",
        "briefing": false,
        "briefinglabel": "Daily briefing",
        "showchips": true,
        "starters": [
            {"label": "What is due?", "prompt": "What is due this week?", "hasicon": true, "iconsvg": "<svg class=\"lucide\">...</svg>"}
        ],
        "hasstarters": true
    }
}}
{{#customcss}}
    <style>{{{customcss}}}</style>
{{/customcss}}
<div class="eledia_aitutor-root" data-region="eledia_aitutor" id="{{uniqid}}"
     data-mode="{{displaymode}}" style="{{brandvars}}">

    <script type="application/json" data-region="eledia_aitutor-config">{{{configjson}}}</script>

    {{^embedded}}
        <button type="button"
                class="btn btn-primary eledia_aitutor-launch eledia_aitutor-launch--{{launcherstyle}}"
                data-action="launch" aria-haspopup="dialog" aria-expanded="false"
                style="{{brandvars}}"
                {{#launchfab}}aria-label="{{launchlabel}}" title="{{launchlabel}}"{{/launchfab}}>
            <span class="eledia_aitutor-launch-icon" aria-hidden="true">
                <img class="eledia_aitutor-launch-img" src="{{logourl}}" alt="" width="20" height="20">
            </span>
            {{#launchcompact}}
                <span class="eledia_aitutor-launch-copy">
                    <span class="eledia_aitutor-launch-kicker">{{persona}}</span>
                    <span class="eledia_aitutor-launch-text">{{launchlabel}}</span>
                </span>
                <span class="eledia_aitutor-launch-arrow" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                </span>
            {{/launchcompact}}
            {{^launchfab}}{{^launchcompact}}<span class="eledia_aitutor-launch-text">{{launchlabel}}</span>{{/launchcompact}}{{/launchfab}}
        </button>
    {{/embedded}}

    <div class="eledia_aitutor-panel {{#embedded}}eledia_aitutor-embedded{{/embedded}}{{#dashboardmode}} eledia_aitutor-panel--hero{{/dashboardmode}}"
         style="{{brandvars}}"
         data-region="panel"
         role="region"
         aria-label="{{persona}}"
         {{^embedded}}hidden{{/embedded}}>

        <div class="eledia_aitutor-backdrop" data-action="close" hidden></div>

        <div class="eledia_aitutor-window" role="document">
            <header class="eledia_aitutor-header{{#dashboardmode}} eledia_aitutor-header--hero{{/dashboardmode}}">
                {{^dashboardmode}}
                    <div class="eledia_aitutor-identity">
                        <a class="eledia_aitutor-avatar" href="https://eledia.ai"
                           target="_blank" rel="noopener"
                           title="{{#str}}eledialink, block_eledia_aitutor{{/str}}"
                           aria-label="{{#str}}eledialink, block_eledia_aitutor{{/str}}">
                            <img class="eledia_aitutor-avatar-img" src="{{logourl}}" alt="" width="34" height="34">
                            <span class="eledia_aitutor-status-dot"></span>
                        </a>
                        <span class="eledia_aitutor-identity-text">
                            <span class="eledia_aitutor-title">{{persona}}</span>
                            <span class="eledia_aitutor-presence">{{#str}}online, block_eledia_aitutor{{/str}}</span>
                        </span>
                    </div>
                {{/dashboardmode}}
                <div class="eledia_aitutor-actions">
                    {{#showexpand}}
                        <button type="button" class="btn btn-icon eledia_aitutor-iconbtn"
                                data-action="expand" aria-label="{{expandlabel}}"
                                title="{{expandlabel}}"
                                data-label-expand="{{expandlabel}}"
                                data-label-collapse="{{collapselabel}}"
                                aria-pressed="false">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><path d="m21 21-6-6m6 6v-4.8m0 4.8h-4.8"/><path d="M3 16.2V21m0 0h4.8M3 21l6-6"/><path d="M21 7.8V3m0 0h-4.8M21 3l-6 6"/><path d="M3 7.8V3m0 0h4.8M3 3l6 6"/></svg>
                        </button>
                    {{/showexpand}}
                    {{#historyenabled}}
                        <button type="button" class="btn btn-icon eledia_aitutor-iconbtn"
                                data-action="history" aria-label="{{#str}}history, block_eledia_aitutor{{/str}}"
                                title="{{#str}}history, block_eledia_aitutor{{/str}}">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </button>
                    {{/historyenabled}}
                    {{^dashboardmode}}
                        <button type="button" class="btn btn-icon eledia_aitutor-iconbtn"
                                data-action="newconversation" aria-label="{{#str}}newconversation, block_eledia_aitutor{{/str}}"
                                title="{{#str}}newconversation, block_eledia_aitutor{{/str}}">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                        </button>
                    {{/dashboardmode}}
                    <button type="button" class="btn btn-icon eledia_aitutor-iconbtn"
                            data-action="privacy" aria-label="{{#str}}privacyguidelines, block_eledia_aitutor{{/str}}"
                            title="{{#str}}privacyguidelines, block_eledia_aitutor{{/str}}"
                            aria-haspopup="dialog">
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                    </button>
                    {{^embedded}}
                        <button type="button" class="btn btn-icon eledia_aitutor-iconbtn"
                                data-action="close" aria-label="{{#str}}close, block_eledia_aitutor{{/str}}"
                                title="{{#str}}close, block_eledia_aitutor{{/str}}">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        </button>
                    {{/embedded}}
                </div>
            </header>

            {{^dashboardmode}}
                {{#llmonly}}
                    <div class="eledia_aitutor-modenote" role="note">
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
                        {{#str}}llmonly_banner, block_eledia_aitutor{{/str}}
                    </div>
                {{/llmonly}}
            {{/dashboardmode}}

            {{#dashboardmode}}
                <div class="eledia_aitutor-hero" data-region="hero">
                    <h2 class="eledia_aitutor-hero-title">
                        <img class="eledia_aitutor-hero-avatar" src="{{avatarurl}}" alt="" width="34" height="34">
                        <span>{{dashboardgreeting}}</span>
                    </h2>
                    {{#welcome}}<div class="eledia_aitutor-hero-sub">{{{welcome}}}</div>{{/welcome}}
                </div>
            {{/dashboardmode}}

            {{#historyenabled}}
                <div class="eledia_aitutor-history" data-region="history" hidden
                     role="region" aria-label="{{#str}}history, block_eledia_aitutor{{/str}}">
                    <div class="eledia_aitutor-history-empty" data-region="history-empty">
                        {{#str}}nohistory, block_eledia_aitutor{{/str}}
                    </div>
                    <div class="eledia_aitutor-history-listwrap" data-region="history-list"></div>
                </div>
            {{/historyenabled}}

            <div class="eledia_aitutor-log" data-region="log"
                 role="log" aria-live="polite" aria-atomic="false"
                 aria-label="{{#str}}conversation, block_eledia_aitutor{{/str}}" tabindex="0">
                {{^dashboardmode}}
                    <div class="eledia_aitutor-message eledia_aitutor-assistant eledia_aitutor-welcome">
                        <div class="eledia_aitutor-meta">
                            <span class="eledia_aitutor-msg-avatar" aria-hidden="true">
                                <img class="eledia_aitutor-msg-avatar-img" src="{{avatarurl}}" alt="" width="20" height="20">
                            </span>
                            <span class="eledia_aitutor-sender">{{persona}}</span>
                        </div>
                        <div class="eledia_aitutor-bubble">{{{welcome}}}</div>
                    </div>
                {{/dashboardmode}}
                {{^dashboardmode}}
                    {{#hasstarters}}
                        <div class="eledia_aitutor-starters" data-region="starters" role="group"
                             aria-label="{{#str}}starters_label, block_eledia_aitutor{{/str}}">
                            {{#starters}}
                                <button type="button" class="eledia_aitutor-starter"
                                        data-action="starter" data-prompt="{{prompt}}">
                                    {{#hasicon}}{{{iconsvg}}} {{/hasicon}}{{label}}
                                </button>
                            {{/starters}}
                        </div>
                    {{/hasstarters}}
                {{/dashboardmode}}
                {{#preview}}{{{previewmessages}}}{{/preview}}
            </div>

            <div class="eledia_aitutor-status" data-region="status" role="status" aria-live="polite"></div>

            {{^consented}}
                <div class="eledia_aitutor-consent" data-region="consent">
                    <p class="eledia_aitutor-consent-text">
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                        {{#str}}consent_intro, block_eledia_aitutor{{/str}}
                    </p>
                    <button type="button" class="btn btn-link p-0 eledia_aitutor-consent-link" data-action="privacy">
                        {{#str}}privacyguidelines, block_eledia_aitutor{{/str}}
                    </button>
                    <div class="form-check eledia_aitutor-consent-check">
                        <input type="checkbox" class="form-check-input" id="{{uniqid}}_consent"
                               data-region="consent-checkbox">
                        <label class="form-check-label" for="{{uniqid}}_consent">
                            {{#str}}consent_checkbox, block_eledia_aitutor{{/str}}
                        </label>
                    </div>
                    <button type="button" class="btn btn-primary eledia_aitutor-consent-accept"
                            data-action="consent-accept" disabled>
                        {{#str}}consent_accept, block_eledia_aitutor{{/str}}
                    </button>
                </div>
            {{/consented}}

            {{#stylechoice}}
                <div class="eledia_aitutor-styles" data-region="styles" role="radiogroup"
                     aria-label="{{#str}}answerstyle, block_eledia_aitutor{{/str}}">
                    {{#styles}}
                        <button type="button" class="eledia_aitutor-stylechip{{#active}} eledia_aitutor-stylechip-active{{/active}}"
                                role="radio" aria-checked="{{#active}}true{{/active}}{{^active}}false{{/active}}"
                                data-action="style" data-style="{{key}}">{{label}}</button>
                    {{/styles}}
                </div>
            {{/stylechoice}}
            {{#stylelocked}}
                <div class="eledia_aitutor-styles">
                    <span class="eledia_aitutor-stylechip eledia_aitutor-stylechip-locked"
                          title="{{#str}}answerstyle, block_eledia_aitutor{{/str}}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> {{lockedlabel}}
                    </span>
                </div>
            {{/stylelocked}}

            {{#dashboardmode}}<div class="eledia_aitutor-hero-footer" data-region="hero-footer">{{/dashboardmode}}
            <form class="eledia_aitutor-composer" data-region="composer"
                  aria-label="{{#str}}messagelabel, block_eledia_aitutor{{/str}}">
                <label class="sr-only" for="{{uniqid}}_input">
                    {{#str}}messagelabel, block_eledia_aitutor{{/str}}
                </label>
                <textarea id="{{uniqid}}_input" class="eledia_aitutor-input" data-region="input"
                          rows="1" autocomplete="off" {{^consented}}disabled{{/consented}}{{#preview}} disabled{{/preview}}
                          placeholder="{{#str}}inputplaceholder, block_eledia_aitutor{{/str}}"></textarea>
                <button type="submit" class="eledia_aitutor-send" data-action="send"
                        {{^consented}}disabled{{/consented}}{{#preview}} disabled{{/preview}}
                        aria-label="{{#str}}send, block_eledia_aitutor{{/str}}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>
                </button>
            </form>

            {{#dashboardmode}}
                {{#showchips}}
                    <div class="eledia_aitutor-starters eledia_aitutor-starters--hero"
                         data-region="starters" role="group"
                         aria-label="{{#str}}starters_label, block_eledia_aitutor{{/str}}">
                        {{#briefing}}
                            <button type="button" class="eledia_aitutor-starter eledia_aitutor-briefing"
                                    data-action="briefing">
                                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg> {{briefinglabel}}
                            </button>
                        {{/briefing}}
                        {{#starters}}
                            <button type="button" class="eledia_aitutor-starter"
                                    data-action="starter" data-prompt="{{prompt}}"
                                    {{#intent}}data-intent="{{intent}}"{{/intent}}>
                                {{#hasicon}}{{{iconsvg}}} {{/hasicon}}{{label}}
                            </button>
                        {{/starters}}
                    </div>
                {{/showchips}}
                </div>
            {{/dashboardmode}}

            {{#showfooter}}
                <div class="eledia_aitutor-footer">{{footertext}}</div>
            {{/showfooter}}
        </div>
    </div>
</div>
